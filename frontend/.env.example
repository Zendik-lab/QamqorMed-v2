# Leave empty in development: the browser calls same-origin /api and Vite
# proxies it to Spring Boot. This works from localhost and from a LAN IP.
VITE_API_URL=
# Internal target used by the Vite dev/preview proxy; it is not sent to the browser.
VITE_DEV_API_TARGET=http://127.0.0.1:8080
VITE_APP_ENV=development
